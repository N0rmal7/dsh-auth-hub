{
  "name": "dsh-auth-hub",
  "displayName": "DSH 账号中心",
  "version": "0.5.2",
  "description": "统一账号中心：13 个内置账号渠道 + 自己加的签到渠道（一键识别 New API 中转站 / 批量导入 / 粘 cURL，自动签到并把奖励记进同一个积分台账）+ WorkBuddy 双区登录，全部收在一个设置页（界面风格对齐 DSH WorkBuddy）。",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "rotation.js",
    "rotation-router.js",
    "workbuddy-growth.js",
    "credit-usage.js",
    "channel-pack.js",
    "checkin-channels.js",
    "checkin-runner.js",
    "vendor/channel-pack/pack.js",
    "vendor/channel-pack/LICENSE",
    "vendor/channel-pack/NOTICE.md",
    "cordis.patch.yml",
    "README.md",
    "vendor/channel-pack/qoder-auth-wasm.wasm",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": "^0.1.2-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "repository": {
    "url": "git+https://github.com/Zhouhang9527/dsh-auth-hub.git",
    "type": "git"
  },
  "homepage": "https://github.com/Zhouhang9527/dsh-auth-hub#readme",
  "bugs": {
    "url": "https://github.com/Zhouhang9527/dsh-auth-hub/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "account",
    "auth",
    "checkin",
    "credit",
    "rotation",
    "channel-pack"
  ],
  "author": "Zhouhang9527"
}